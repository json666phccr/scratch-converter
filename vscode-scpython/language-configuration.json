{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(when\\b.*|init\\s*|def\\b.*|if\\b.*|elif\\b.*|else\\s*|while\\b.*|for\\b.*):\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(elif\\b.*|else\\s*):?\\s*(#.*)?$"
  }
}
